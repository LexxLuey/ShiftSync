DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shiftsync
REDIS_URL=
JWT_SECRET=replace-with-a-secure-secret
PORT=4000

# Reminder worker configuration
REMINDER_POLL_INTERVAL_MS=15000
REMINDER_RETRY_DELAY_MS=300000
REMINDER_MAX_RETRIES=3
REMINDER_WORKER_BATCH_SIZE=50
REMINDER_JOB_LOCK_TTL_SECONDS=30

# SMTP email reminder configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Swagger configuration
SWAGGER_ENABLED=true
SWAGGER_PROTECT_IN_PROD=true
SWAGGER_DOCS_TOKEN=replace-with-a-strong-docs-token
SWAGGER_SERVER_URL=http://localhost:4000
